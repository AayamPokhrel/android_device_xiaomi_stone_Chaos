type vendor_stflashtool, domain;
type vendor_stflashtool_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(vendor_stflashtool)

allow vendor_stflashtool nfc_device:chr_file rw_file_perms;
allowxperm vendor_stflashtool nfc_device:chr_file ioctl { 0xea00-0xea20 };

get_prop(vendor_stflashtool, nfc_prop)

allow vendor_stflashtool same_process_hal_file:file rx_file_perms;
allow vendor_stflashtool vendor_file:file rx_file_perms;
