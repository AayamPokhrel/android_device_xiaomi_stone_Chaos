type vendor_sysfs_double_tap, sysfs_type, fs_type;

allow hal_power_default vendor_sysfs_double_tap:dir search;
allow hal_power_default vendor_sysfs_double_tap:file rw_file_perms;

allow hal_power_default sysfs:file { open read write };

allow hal_power_default hal_graphics_composer_default:dir search;
allow hal_power_default hal_graphics_composer_default:file { open read };

allow hal_power_default vendor_latency_device:chr_file rw_file_perms;

allow hal_power_default hal_thermal_service:service_manager find;
hal_client_domain(hal_power_default, hal_thermal)

allow hal_power_default powerhal_vendor_data_file:dir rw_dir_perms;
allow hal_power_default powerhal_vendor_data_file:file create_file_perms;

# Allow hal_power to access IStats AIDL
allow hal_power_default fwk_stats_service:service_manager find;
binder_call(hal_power_default, stats_service_server);

# Display config
hal_client_domain(hal_power_default, hal_graphics_composer)
allow hal_power_default vendor_hal_vnddisplayconfig_service:service_manager find;
dontaudit hal_power_default default_android_service:service_manager find;

