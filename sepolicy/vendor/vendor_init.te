set_prop(vendor_init, vendor_fp_prop)
set_prop(vendor_init, vendor_qcc_prop)

set_prop(vendor_init, vendor_zram_prop);

# Stereospeaker mod
allow init vendor_configs_file:file mounton;

allow vendor_init proc_sched:file w_file_perms;
dontaudit vendor_init tmpfs:dir create_dir_perms;
allow vendor_init cache_file:dir { getattr setattr };
