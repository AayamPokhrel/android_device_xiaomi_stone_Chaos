#
# system.prop for POCO X5 5G / Redmi Note 12 5G
#

# RIL
rild.libpath=/vendor/lib64/libril-qc-hal-qmi.so
ril.subscription.types=NV,RUIM
DEVICE_PROVISIONED=1

# Set network mode to (NR_LTE_TDSCDMA_CDMA_EVDO_GSM_WCDMA) for DSDS
ro.telephony.default_network=33,33
telephony.lteOnCdmaDevice=1
persist.vendor.radio.atfwd.start=true

# BPF
ro.bpf.kver_override=5.10.239

# Dalvik / ART
dalvik.vm.dex2oat64.enabled=true
pm.dexopt.install=quicken
pm.dexopt.bg-dexopt=speed-profile
pm.dexopt.boot-after-ota=verify
pm.dexopt.first-boot=quicken

# Audio / Media (Generic)
qcom.hw.aac.encoder=true
media.aac_51_output_enabled=true
vendor.mm.enable.qcom_parser=16777215
persist.mm.enable.prefetch=true
ro.media.recorder-max-base-layer-fps=60
tunnel.audio.encode=true
use.voice.path.for.pcm.voip=true

# Data Modules
ro.vendor.use_data_netmgrd=true
persist.vendor.data.mode=concurrent
persist.rmnet.data.enable=true
persist.data.wda.enable=true
persist.data.df.dl_mode=5
persist.data.df.ul_mode=5
persist.data.df.agg.dl_pkt=10
persist.data.df.agg.dl_size=4096
persist.data.df.mux_count=8
persist.data.df.iwlan_mux=9
persist.data.df.dev_name=rmnet_usb0

# Graphics
ro.opengles.version=196610
debug.sf.enable_hwc_vds=0

# Bluetooth
ro.bluetooth.emb_wp_mode=false
ro.bluetooth.wipower=false

# Sensors / Features
sys.qca1530=detect
ro.qc.sdk.audio.ssr=false
ro.qc.sdk.audio.fluencetype=none
persist.audio.fluence.voicecall=true
persist.audio.fluence.voicerec=false
persist.audio.fluence.speaker=true

# Time Services
persist.backup.ntpServer="0.pool.ntp.org"
persist.timed.enable=true

# Storage
persist.fuse_sdcard=true
persist.sys.fuse.passthrough.enable=true
ro.incremental.enable=true

# Misc
dev.pm.dyn_samplingrate=1
ro.charger.enable_suspend=1
persist.debug.wfd.enable=1
persist.sys.wfd.virtual=0
qemu.hw.mainkeys=0

# Memory Management
arm64.memtag.process.system_server=off

# Multi-Gen LRU
persist.device_config.mglru_native.lru_gen_config=core_and_mm_walk
